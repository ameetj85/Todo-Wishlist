{
  "name": "auth-api",
  "version": "1.0.0",
  "description": "Production-ready REST API authentication system with SQLite",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "prisma generate && npm run build",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "test": "npm run build && DATABASE_URL=file:./data/test.db prisma db push && node --test --test-concurrency=1 dist/src/tests/**/*.test.js",
    "test:watch": "DATABASE_URL=file:./data/test.db prisma db push && (tsc --watch --preserveWatchOutput & node --test --test-concurrency=1 --watch dist/src/tests/**/*.test.js)",
    "test:coverage": "npm run build && DATABASE_URL=file:./data/test.db prisma db push && node --experimental-test-coverage --test --test-concurrency=1 dist/src/tests/**/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:init": "prisma db push",
    "db:reset": "prisma db push --force-reset",
    "db:seed": "node dist/scripts/db-seed.js",
    "db:cleanup": "node dist/scripts/db-cleanup.js",
    "db:recompress-images": "node dist/scripts/db-recompress-images.js",
    "prisma:generate": "prisma generate",
    "check:env": "node dist/scripts/check-env.js"
  },
  "keywords": [
    "auth",
    "authentication",
    "rest-api",
    "express",
    "sqlite",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "nodemailer": "^8.0.4",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.1.0",
    "prisma": "^7.6.0",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
